---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogUrl?: string;
  /** true のとき、ヘッダーをヒーロー上では透明にし、ヒーロー通過後に色付きにする（Topページ用） */
  transparentHeader?: boolean;
}

const {
  title,
  description = 'My Portfolio — 制作実績・プロフィールをご覧ください。',
  ogImage,
  ogUrl,
  transparentHeader = false,
} = Astro.props;

const siteUrl = 'https://my-portfolio.hanada87.workers.dev';
const pageTitle = `${title} | My Portfolio`;
const resolvedImage = ogImage ?? `${siteUrl}/og-default.png`;
const resolvedUrl = ogUrl ?? `${siteUrl}${Astro.url.pathname}`;
---
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />

    <!-- OGP -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={resolvedUrl} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="My Portfolio" />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImage} />

    <slot name="head" />
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans">
    <header
      id="site-header"
      class="fixed inset-x-0 top-0 z-50 h-15 px-8 flex justify-between items-center bg-[#299dff] transition-colors duration-300 data-[transparent]:bg-transparent"
      data-transparent={transparentHeader ? '' : undefined}
    >
      <a href="/" class="text-white font-bold text-lg">My Portfolio</a>
      <nav>
        <a href="/" class="text-white hover:text-gray-300 ml-6 text-sm transition-colors">Home</a>
        <a href="/projects" class="text-white hover:text-gray-300 ml-6 text-sm transition-colors">Works</a>
        <a href="/about" class="text-white hover:text-gray-300 ml-6 text-sm transition-colors">About</a>
      </nav>
    </header>
    <!-- 固定ヘッダーの高さ分の余白（透明ヘッダーのページはヒーローを最上部まで広げるため不要） -->
    {!transparentHeader && <div class="h-15" aria-hidden="true"></div>}
    <slot name="hero" />
    <main class="max-w-4xl mx-auto px-6 py-10">
      <slot />
    </main>
    <footer class="text-center py-8 text-gray-400 text-xs border-t border-gray-100 mt-16">
      © 2026 My Portfolio
    </footer>

    <script>
      // 透明ヘッダーのページ：ヒーローがヘッダーの下を通過したら背景色を付ける
      const header = document.getElementById('site-header');
      const hero = document.getElementById('hero');
      if (header && hero && header.hasAttribute('data-transparent')) {
        const observer = new IntersectionObserver(
          ([entry]) => {
            header.toggleAttribute('data-transparent', entry.isIntersecting);
          },
          // ヘッダーの高さ分だけ判定範囲を上から縮め、ヒーロー下端がヘッダー下端を越えた時点で切り替える
          { rootMargin: `-${header.offsetHeight}px 0px 0px 0px` }
        );
        observer.observe(hero);
      }
    </script>
  </body>
</html>
