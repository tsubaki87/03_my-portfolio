---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogUrl?: string;
}

const {
  title,
  description = 'My Portfolio — 制作実績・プロフィールをご覧ください。',
  ogImage,
  ogUrl,
} = Astro.props;

const siteUrl = 'https://my-portfolio.hanada87.workers.dev';
const pageTitle = `${title} | My Portfolio`;
const resolvedImage = ogImage ?? `${siteUrl}/og-default.png`;
const resolvedUrl = ogUrl ?? `${siteUrl}${Astro.url.pathname}`;
---
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- OGP -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={resolvedUrl} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="My Portfolio" />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImage} />
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans">
    <header class="bg-[#0a2448] px-8 py-4 flex justify-between items-center">
      <a href="/" class="text-white font-bold text-lg">My Portfolio</a>
      <nav>
        <a href="/" class="text-gray-300 hover:text-white ml-6 text-sm transition-colors">Home</a>
        <a href="/projects" class="text-gray-300 hover:text-white ml-6 text-sm transition-colors">Works</a>
        <a href="/about" class="text-gray-300 hover:text-white ml-6 text-sm transition-colors">About</a>
      </nav>
    </header>
    <main class="max-w-4xl mx-auto px-6 py-10">
      <slot />
    </main>
    <footer class="text-center py-8 text-gray-400 text-xs border-t border-gray-100 mt-16">
      © 2026 My Portfolio
    </footer>
  </body>
</html>
