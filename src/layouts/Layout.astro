---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | My Portfolio</title>
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans">
    <header class="bg-[#0a2448] px-8 py-4 flex justify-between items-center">
      <a href="/" class="text-white font-bold text-lg">My Portfolio</a>
      <nav>
        <a href="/" class="text-gray-300 hover:text-white ml-6 text-sm transition-colors">Home</a>
        <a href="/projects" class="text-gray-300 hover:text-white ml-6 text-sm transition-colors">Works</a>
        <a href="/about" class="text-gray-300 hover:text-white ml-6 text-sm transition-colors">About</a>
      </nav>
    </header>
    <main class="max-w-4xl mx-auto px-6 py-10">
      <slot />
    </main>
    <footer class="text-center py-8 text-gray-400 text-xs border-t border-gray-100 mt-16">
      © 2026 My Portfolio
    </footer>
  </body>
</html>
