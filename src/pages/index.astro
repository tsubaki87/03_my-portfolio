---
import Layout from '../layouts/Layout.astro';
import { client, urlFor } from '../lib/sanity';

const projects = await client.fetch(`
  *[_type == "project"] | order(publishedAt desc)[0...3] {
    _id, title, slug, description, tags, publishedAt, mainImage
  }
`);

const about = await client.fetch(`
  *[_type == "about"][0] { name, bio, skills }
`);
---
<Layout
  title="Home"
  description={about?.bio ?? 'ポートフォリオサイトです。制作実績やプロフィールをご覧ください。'}
>
  <section class="text-center py-16">
    <h1 class="text-4xl font-bold text-[#0a2448]">
      {about?.name ?? 'My Portfolio'}
    </h1>
    {about?.bio && (
      <p class="mt-4 text-gray-500 max-w-md mx-auto leading-relaxed">
        {about.bio}
      </p>
    )}
    {about?.skills && (
      <div class="mt-6 flex flex-wrap gap-2 justify-center">
        {about.skills.map((s: string) => (
          <span class="bg-blue-50 text-[#0a2448] px-3 py-1 rounded-full text-sm">
            {s}
          </span>
        ))}
      </div>
    )}
  </section>

  <section>
    <h2 class="text-xl font-bold text-[#0a2448] border-l-4 border-[#4a9eff] pl-3 mb-6">
      Recent Works
    </h2>
    {projects.length === 0 ? (
      <p class="text-gray-400">制作実績はまだありません。</p>
    ) : (
      <div class="grid gap-4">
        {projects.map((p: any) => (
          <a href={`/projects/${p.slug.current}`}
            class="bg-white border border-gray-200 flex rounded hover:shadow-md transition-shadow overflow-hidden">
            {p.mainImage ? (
              <img
                src={urlFor(p.mainImage).width(400).height(300).fit('crop').url()}
                alt={p.title}
                class="w-48 shrink-0 object-cover"
              />
            ) : (
              <div class="w-48 shrink-0 bg-gray-100 flex items-center justify-center text-gray-300 text-sm">
                No Image
              </div>
            )}
            <div class="p-6 flex flex-col justify-center">
              <h3 class="text-lg font-bold text-[#0a2448]">{p.title}</h3>
              {p.description && (
                <p class="text-gray-500 text-sm mt-2 leading-relaxed">{p.description}</p>
              )}
              {p.tags && (
                <div class="mt-3 flex flex-wrap gap-1">
                  {p.tags.map((t: string) => (
                    <span class="bg-gray-100 text-gray-500 px-2 py-0.5 text-xs rounded">{t}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    )}
    <div class="text-right mt-4">
      <a href="/projects" class="text-[#4a9eff] text-sm hover:underline">すべての実績を見る →</a>
    </div>
  </section>
</Layout>
