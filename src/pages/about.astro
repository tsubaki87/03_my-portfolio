---
import Layout from '../layouts/Layout.astro';
import { client } from '../lib/sanity';

const about = await client.fetch(`
  *[_type == "about"][0] { name, bio, skills }
`);
---
<Layout title="About">
  <h1 class="text-3xl font-bold text-[#0a2448] mb-8">About</h1>

  {!about ? (
    <p class="text-gray-400">プロフィールはまだ登録されていません。</p>
  ) : (
    <div class="bg-white border border-gray-200 p-8 rounded">
      <h2 class="text-2xl font-bold text-[#0a2448] mb-4">
        {about.name}
      </h2>
      {about.bio && (
        <p class="text-gray-500 leading-relaxed whitespace-pre-wrap">{about.bio}</p>
      )}
      {about.skills && (
        <div class="mt-6">
          <h3 class="text-sm font-bold text-gray-400 mb-3">Skills</h3>
          <div class="flex flex-wrap gap-2">
            {about.skills.map((s: string) => (
              <span class="bg-blue-50 text-[#0a2448] px-3 py-1 rounded-full text-sm">
                {s}
              </span>
            ))}
          </div>
        </div>
      )}
    </div>
  )}
</Layout>
