---
import Layout from '../../layouts/Layout.astro';
import { client, urlFor } from '../../lib/sanity';

const projects = await client.fetch(`
  *[_type == "project"] | order(publishedAt desc) {
    _id, title, slug, description, tags, publishedAt, mainImage
  }
`);
---
<Layout title="Works">
  <h1 class="text-3xl font-bold text-[#0a2448] mb-8">Works</h1>
  {projects.length === 0 ? (
    <p class="text-gray-400">制作実績はまだありません。</p>
  ) : (
    <div class="grid gap-4">
      {projects.map((p: any) => (
        <a href={`/projects/${p.slug.current}`}
          class="bg-white border border-gray-200 block rounded hover:shadow-md transition-shadow overflow-hidden">
          {p.mainImage && (
            <img
              src={urlFor(p.mainImage).width(800).height(400).fit('crop').url()}
              alt={p.title}
              class="w-full h-48 object-cover"
            />
          )}
          <div class="p-6">
            <h2 class="text-lg font-bold text-[#0a2448]">{p.title}</h2>
            {p.description && (
              <p class="text-gray-500 text-sm mt-2 leading-relaxed">{p.description}</p>
            )}
            {p.tags && (
              <div class="mt-3 flex flex-wrap gap-1">
                {p.tags.map((t: string) => (
                  <span class="bg-gray-100 text-gray-500 px-2 py-0.5 text-xs rounded">{t}</span>
                ))}
              </div>
            )}
            {p.publishedAt && (
              <p class="text-gray-300 text-xs mt-3">{p.publishedAt}</p>
            )}
          </div>
        </a>
      ))}
    </div>
  )}
</Layout>
