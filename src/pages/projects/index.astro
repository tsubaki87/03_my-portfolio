---
import Layout from '../../layouts/Layout.astro';
import { client, urlFor } from '../../lib/sanity';
import { getYouTubeId, youTubeThumbnailUrl } from '../../lib/youtube';

const projects = await client.fetch(`
  *[_type == "project"] | order(publishedAt desc) {
    _id, title, slug, category, description, tags, publishedAt, mainImage, youtubeUrl
  }
`);

// カテゴリー（Sanity の「カテゴリー」と同じ値）。並び順はタブの順番
const categories = [
  { value: 'run', label: 'RUN' },
  { value: 'fun', label: 'FUN' },
  { value: 'play', label: 'PLAY' },
];
const categoryLabel = (value?: string) => categories.find((c) => c.value === value)?.label;

// カード画像（16:9）のURL。画面幅に応じてブラウザが適切なサイズを選ぶ
const imageWidths = [480, 720, 1080];
const sanityImage = (img: any, w: number) =>
  urlFor(img).width(w).height(Math.round((w * 9) / 16)).fit('crop').auto('format').url();
---
<Layout title="Project" description="制作実績の一覧です。" wideMain>
  <h1 class="text-3xl font-bold text-[#0a2448] mb-8">Project</h1>
  {projects.length === 0 ? (
    <p class="text-gray-400">制作実績はまだありません。</p>
  ) : (
    <>
      <!-- カテゴリーの切り替えタブ。選んだカテゴリーは URL（?category=run など）にも残し、共有・再読み込みで復元する -->
      <div class="flex flex-wrap gap-2 mb-8" role="group" aria-label="カテゴリーで絞り込む" data-category-tabs>
        {[{ value: 'all', label: 'ALL' }, ...categories].map((c) => (
          <button
            type="button"
            data-category-tab={c.value}
            aria-pressed={c.value === 'all' ? 'true' : 'false'}
            class="category-tab rounded-full border border-[#0a2448] px-5 py-2 text-sm font-bold tracking-widest text-[#0a2448] transition-colors hover:bg-blue-50"
          >
            {c.label}
          </button>
        ))}
      </div>

      <!-- スマホ1列 → タブレット2列 → PC3列 -->
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((p: any) => {
          const ytId = getYouTubeId(p.youtubeUrl);
          const label = categoryLabel(p.category);
          return (
            <a href={`/projects/${p.slug.current}`}
              data-category={p.category ?? ''}
              class="group flex flex-col bg-white border border-gray-200 rounded overflow-hidden hover:shadow-md transition-shadow">
              <!-- 画像（16:9）。画像がない作品も同じ高さの枠を確保してカードの高さをそろえる -->
              <div class="relative aspect-video overflow-hidden bg-gray-100">
                {p.mainImage ? (
                  <img
                    src={sanityImage(p.mainImage, 720)}
                    srcset={imageWidths.map((w) => `${sanityImage(p.mainImage, w)} ${w}w`).join(', ')}
                    sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
                    alt={p.title}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                  />
                ) : ytId ? (
                  <img
                    src={youTubeThumbnailUrl(ytId)}
                    alt={p.title}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                  />
                ) : null}
                {label && (
                  <span class="absolute top-3 left-3 bg-[#0a2448] text-white text-xs font-bold tracking-widest px-2 py-1 rounded">
                    {label}
                  </span>
                )}
                {ytId && (
                  <span class="absolute top-3 right-3 bg-black/70 text-white text-xs px-2 py-1 rounded">
                    ▶ Video
                  </span>
                )}
              </div>

              <div class="flex flex-1 flex-col p-5">
                <h2 class="text-base font-bold text-[#0a2448] leading-snug line-clamp-2">{p.title}</h2>
                {p.description && (
                  <p class="text-gray-500 text-sm mt-2 leading-relaxed line-clamp-2">{p.description}</p>
                )}
                {p.tags && (
                  <div class="mt-3 flex flex-wrap gap-1">
                    {p.tags.map((t: string) => (
                      <span class="bg-gray-100 text-gray-500 px-2 py-0.5 text-xs rounded">{t}</span>
                    ))}
                  </div>
                )}
                <!-- 日付はカードの下端にそろえる -->
                {p.publishedAt && (
                  <p class="text-gray-300 text-xs mt-auto pt-3">{p.publishedAt}</p>
                )}
              </div>
            </a>
          );
        })}
      </div>

      <p class="text-gray-400 mt-4" data-category-empty hidden>このカテゴリーの制作実績はまだありません。</p>
    </>
  )}
</Layout>

<style>
  /* 選択中のタブは塗りつぶす */
  .category-tab[aria-pressed='true'] {
    background-color: #0a2448;
    color: #fff;
  }
</style>

<script>
  // カテゴリーの切り替え。JS が動かない環境では全件がそのまま表示される
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category-tab]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-category]'));
  const emptyMessage = document.querySelector<HTMLElement>('[data-category-empty]');
  const validValues = tabs.map((t) => t.dataset.categoryTab!);

  const select = (value: string, updateUrl: boolean) => {
    if (!validValues.includes(value)) value = 'all';

    for (const tab of tabs) {
      tab.setAttribute('aria-pressed', String(tab.dataset.categoryTab === value));
    }

    let shown = 0;
    for (const card of cards) {
      const match = value === 'all' || card.dataset.category === value;
      card.hidden = !match;
      if (match) shown++;
    }
    if (emptyMessage) emptyMessage.hidden = shown > 0;

    if (updateUrl) {
      const url = new URL(location.href);
      if (value === 'all') url.searchParams.delete('category');
      else url.searchParams.set('category', value);
      history.replaceState(null, '', url);
    }
  };

  for (const tab of tabs) {
    tab.addEventListener('click', () => select(tab.dataset.categoryTab!, true));
  }

  // URL に ?category=run などがあれば、そのカテゴリーを選んだ状態で開く
  const initial = new URLSearchParams(location.search).get('category');
  if (initial) select(initial, false);
</script>
