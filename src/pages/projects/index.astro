---
import Layout from '../../layouts/Layout.astro';
import { client } from '../../lib/sanity';

const projects = await client.fetch(`
  *[_type == "project"] | order(publishedAt desc) {
    _id, title, slug, description, tags, publishedAt
  }
`);
---
<Layout title="Works">
  <h1 style="font-size:1.8rem; font-weight:bold; color:#0a2448; margin-bottom:2rem;">Works</h1>
  {projects.length === 0 ? (
    <p style="color:#999;">制作実績はまだありません。</p>
  ) : (
    <div style="display:grid; gap:1.5rem;">
      {projects.map((p: any) => (
        <a href={`/projects/${p.slug.current}`}
          style="background:#fff; border:1px solid #e5e7eb; padding:1.5rem; display:block;">
          <h2 style="font-size:1.1rem; font-weight:bold; color:#0a2448;">{p.title}</h2>
          {p.description && (
            <p style="color:#666; font-size:0.9rem; margin-top:0.5rem; line-height:1.6;">{p.description}</p>
          )}
          {p.tags && (
            <div style="margin-top:0.75rem; display:flex; flex-wrap:wrap; gap:0.4rem;">
              {p.tags.map((t: string) => (
                <span style="background:#f1f5f9; color:#475569; padding:0.2rem 0.6rem; font-size:0.75rem;">{t}</span>
              ))}
            </div>
          )}
          {p.publishedAt && (
            <p style="color:#aaa; font-size:0.75rem; margin-top:0.75rem;">{p.publishedAt}</p>
          )}
        </a>
      ))}
    </div>
  )}
</Layout>
